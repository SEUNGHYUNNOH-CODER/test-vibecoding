{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
    "skills": {
        "fastapi-backend-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "FastAPI backend development patterns for Python async applications with SQLModel/SQLAlchemy, domain-driven design, and layered architecture",
            "promptTriggers": {
                "keywords": [
                    "backend",
                    "backend development",
                    "fastapi",
                    "FastAPI",
                    "service",
                    "repository",
                    "route",
                    "router",
                    "routing",
                    "API",
                    "endpoint",
                    "async",
                    "await",
                    "SQLModel",
                    "SQLAlchemy",
                    "database",
                    "orm",
                    "domain",
                    "dto",
                    "pydantic",
                    "validation",
                    "model",
                    "middleware"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(route|endpoint|API|router|service|repository)",
                    "(fix|handle|debug).*?(error|exception|backend)",
                    "(add|implement).*?(middleware|validation|error.*?handling)",
                    "(organize|structure|refactor).*?(backend|service|API|domain)",
                    "(how to|best practice).*?(backend|fastapi|route|router|service|repository)",
                    "(async|await).*?(pattern|function|method)",
                    "(database|orm|model).*?(query|create|update|delete)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "backend/backend/**/*.py",
                    "backend/backend/api/**/*.py",
                    "backend/backend/domain/**/*.py",
                    "backend/backend/dtos/**/*.py"
                ],
                "pathExclusions": [
                    "**/__pycache__/**",
                    "**/*.pyc",
                    "**/test_*.py",
                    "**/*_test.py",
                    "**/conftest.py"
                ],
                "contentPatterns": [
                    "from fastapi import",
                    "@router\\.",
                    "async def",
                    "AsyncSession",
                    "SQLModel",
                    "BaseRepository",
                    "class.*Service:",
                    "class.*Repository:"
                ]
            }
        },
        "nextjs-frontend-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Next.js 15/React 19/TypeScript best practices including App Router patterns and shadcn/ui",
            "promptTriggers": {
                "keywords": [
                    "component",
                    "react component",
                    "UI",
                    "interface",
                    "page",
                    "modal",
                    "dialog",
                    "form",
                    "shadcn",
                    "Tailwind",
                    "styling",
                    "frontend",
                    "React",
                    "Next.js",
                    "nextjs",
                    "server component",
                    "client component",
                    "app router",
                    "use client"
                ],
                "intentPatterns": [
                    "(create|add|make|build|update|modify|edit).*?(component|UI|page|modal|dialog|form)",
                    "(how to|best practice).*?(component|react|nextjs|next.js)",
                    "(style|design|layout).*?(component|UI)",
                    "(server|client).*?component",
                    "app router"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "frontend/src/**/*.tsx",
                    "frontend/src/**/*.ts",
                    "frontend/src/app/**/*.tsx",
                    "frontend/src/app/**/*.ts",
                    "frontend/src/components/**/*.tsx"
                ],
                "pathExclusions": [
                    "**/*.test.tsx",
                    "**/*.test.ts",
                    "**/*.spec.tsx",
                    "**/*.spec.ts",
                    "**/next.config.*",
                    "**/tsconfig.json"
                ],
                "contentPatterns": [
                    "'use client'",
                    "'use server'",
                    "export default async function",
                    "next/navigation",
                    "next/image"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        }
    }
}
